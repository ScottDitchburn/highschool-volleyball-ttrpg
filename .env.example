# Optional cloud saves (Supabase). Leave these unset and the app runs exactly as
# before — localStorage autosave + JSON export only, Cloud control hidden.
#
# Copy to .env.local (git-ignored) and fill in from
#   Supabase dashboard → Project Settings → API keys
#
# Both values are safe to ship in client code: the publishable ("anon") key only
# ever reaches the database through Row Level Security. Never add the
# service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
